# --- SENSITIVE DATA (CRITICAL) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.secret
*.pem
*.key

# --- DEPENDENCIES ---
# Never upload these; they are rebuilt via 'npm install'
node_modules/
jspm_packages/
.pnp
.pnp.js

# --- BUILD OUTPUT ---
# These are generated during deployment
dist/
build/
.next/
out/
bin/
obj/

# --- LOGS AND DIAGNOSTICS ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs
pids
*.pid
*.seed

# --- SYSTEM FILES ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE/EDITOR SETTINGS ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- TESTING ---
/coverage
/.nyc_output

# --- WORDPRESS SPECIFIC (If using WooCommerce) ---
wp-config.php
wp-content/uploads/
wp-content/upgrade/
wp-content/backup-db/